# ===========================================
# NotionTutor - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values
# Never commit .env.local to version control!

# -------------------------------------------
# Database (Supabase PostgreSQL)
# Configured in Story 0.2
# -------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# -------------------------------------------
# Authentication (Notion OAuth)
# Configured in Epic 1
# Get credentials at: https://www.notion.so/my-integrations
# -------------------------------------------
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
NOTION_REDIRECT_URI="http://localhost:3000/api/auth/notion/callback"

# -------------------------------------------
# LLM Provider (OpenAI)
# Configured in Story 0.5
# Get API key at: https://platform.openai.com/api-keys
# -------------------------------------------
OPENAI_API_KEY=""
# Set to "true" to use mock responses (saves API costs in dev)
MOCK_LLM="true"

# -------------------------------------------
# Email Service (Resend)
# Configured in Epic 4
# Get API key at: https://resend.com/api-keys
# -------------------------------------------
RESEND_API_KEY=""
# Sender for digest emails — must use a domain verified in Resend
DIGEST_FROM_EMAIL="NotionTutor <digest@notiontutor.com>"

# -------------------------------------------
# Security & Encryption
# -------------------------------------------
# 32 bytes, base64 encoded - generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Random string for session cookies - generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=""

# -------------------------------------------
# Cron Jobs (Vercel)
# Random secret to protect cron endpoints
# -------------------------------------------
CRON_SECRET=""

# -------------------------------------------
# Admin API
# Secret to protect /api/admin/* endpoints
# -------------------------------------------
ADMIN_SECRET=""

# -------------------------------------------
# Environment
# -------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
